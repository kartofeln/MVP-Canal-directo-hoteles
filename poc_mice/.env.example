# Base de datos — elige UNA:
# A) Sin Docker (recomendado para probar en local):
DATABASE_URL=sqlite:///./mice_poc.db
# B) Con Docker: docker compose up -d y luego descomenta:
# DATABASE_URL=postgresql+psycopg2://mice:mice_dev@127.0.0.1:5433/mice_poc

# DataForSEO (Basic auth: email + API password)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Anthropic — briefs en /v1/brief/generate
ANTHROPIC_API_KEY=

# Kapso — envío opcional tras ingest o brief
KAPSO_API_KEY=
# Número E.164 destino para pruebas (opcional)
KAPSO_TEST_TO=

# Si defines un secreto, el webhook exige header: X-Webhook-Secret: <valor>
KAPSO_WEBHOOK_SECRET=

# 1 = permite POST /v1/ingest/demo-local (datos ficticios para probar CSV/Excel sin DataForSEO)
POC_ALLOW_FAKE_DATA=0
